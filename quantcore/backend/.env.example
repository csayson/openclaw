# QuantCore AI — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to version control.

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_VAULT_IN_PRODUCTION_MIN_32_CHARS

# Database
DATABASE_URL=postgresql+asyncpg://quantcore:quantcore@localhost:5432/quantcore
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Alpaca (paper trading by default)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# OANDA (practice by default)
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ENVIRONMENT=practice

# Interactive Brokers (TWS paper)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# Data APIs
ALPHA_VANTAGE_KEY=
FRED_API_KEY=
NEWS_API_KEY=
UNUSUAL_WHALES_KEY=
SIMFIN_API_KEY=

# AI
ANTHROPIC_API_KEY=

# Notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reports@quantcore.ai
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS (use IAM roles in prod, not hardcoded keys)
AWS_REGION=us-east-1
S3_BUCKET_REPORTS=quantcore-reports
S3_BUCKET_MODELS=quantcore-models

# Risk defaults (override per account via DB)
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_DRAWDOWN_PCT=3.0
MAX_WEEKLY_DRAWDOWN_PCT=5.0
MAX_OPEN_POSITIONS=8
MARGIN_CAP_PCT=20.0
CIRCUIT_BREAKER_PCT=7.0
